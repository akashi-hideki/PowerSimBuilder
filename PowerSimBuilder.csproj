<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PowerSimBuilder</RootNamespace>
    <AssemblyName>PowerSimBuilder</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.11.1</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>

    <!--
      WFO1000: DesignerSerializationVisibility warning on custom control
      properties. Enabled as error by default in .NET 9+ WinForms analyzers.
      The properties work fine at runtime; this is a designer-only concern.
      Suppress for now; add [DesignerSerializationVisibility(Hidden)] later
      if designer support is needed.
    -->
    <NoWarn>$(NoWarn);WFO1000;NU1701</NoWarn>

    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Copyright>Copyright 2026 Hideki Akashi</Copyright>
    <Authors>Hideki Akashi</Authors>
    <RepositoryUrl>https://github.com/akashi-hideki/PowerSimBuilder</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- SDK-style auto-glob excludes: non-project source folders -->
  <ItemGroup>
    <Compile Remove="PowerSimBuilder.Tests\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="**\obj\**\*.cs" />
    <Compile Remove="**\bin\**\*.cs" />
    <Compile Remove="_backup_*\**\*.cs" />
    <Compile Remove="previou_files\**\*.cs" />

    <EmbeddedResource Remove="PowerSimBuilder.Tests\**\*" />
    <EmbeddedResource Remove="_backup_*\**\*" />
    <EmbeddedResource Remove="previou_files\**\*" />

    <None Remove="PowerSimBuilder.Tests\**\*" />
    <None Remove="_backup_*\**\*" />
    <None Remove="previou_files\**\*" />
      <PackageReference Include="Scintilla5.NET" Version="7.1.1" />
</ItemGroup>

  <ItemGroup>
    <PackageReference Include="ncalc" Version="1.3.8" />
  </ItemGroup>

  <ItemGroup>
    <None Update="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/i18n/**/*.json" />
    <Content Include="Resources/catalog_sources.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- FMU-MVP1: exclude backup & tmp from compile -->
  <ItemGroup>
    <Compile Remove="tmp/**" />
    <Compile Remove="user_physics_models/**" />
    <None Include="user_physics_models/**" />
  
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PowerSimBuilder.Tests" />
    <InternalsVisibleTo Include="PowerSimBuilder.UITests" />
  </ItemGroup>
</Project>
