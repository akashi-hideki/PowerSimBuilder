"""Pre-publication tasks:
1. refresh_ip_docs.py for v1.10.1 (idempotency check)
2. Commit if changes
3. pre_public_check.ps1
"""
from __future__ import annotations
import os
import pathlib
import subprocess
import sys

REPO = pathlib.Path(__file__).resolve().parent.parent
REFRESH = REPO / "tools" / "refresh_ip_docs.py"
PRECHECK = REPO / "tools" / "pre_public_check.ps1"
GCOMMIT = REPO / "tools" / "gcommit.ps1"

TEST_COUNTS = "608,58,19,30"  # C#, Python, UITests, RoleSnippet (approx; verify_all will confirm)
VERSION = "v1.10.1"


def run(cmd, check=True, label=""):
    shell = isinstance(cmd, str)
    env = os.environ.copy()
    env["PYTHONIOENCODING"] = "utf-8"
    env["PYTHONUTF8"] = "1"
    if label:
        print(f"\n>>> [{label}] {' '.join(cmd) if not shell else cmd}")
    else:
        print(f"\n>>> {' '.join(cmd) if not shell else cmd}")
    r = subprocess.run(cmd, cwd=str(REPO), shell=shell,
                       capture_output=True, text=True, encoding="utf-8",
                       errors="replace", env=env)
    if r.stdout.strip():
        print(r.stdout.rstrip())
    if r.stderr.strip():
        print("[stderr]", r.stderr.rstrip()[:500])
    if check and r.returncode != 0:
        print(f"[FAIL] exit {r.returncode}")
        sys.exit(1)
    return r


def step_a_git_status():
    print("\n=== A. git status ===")
    run(["git", "status", "--short"])
    run(["git", "log", "--oneline", "-2"])
    run(["git", "tag", "-l", "v1.10*"])


def step_b_refresh_ip_docs():
    print("\n=== B. refresh_ip_docs.py (1st pass) ===")
    if not REFRESH.is_file():
        print(f"[ERR] {REFRESH} not found")
        sys.exit(1)
    run([sys.executable, str(REFRESH), "--version", VERSION, "--test-counts", TEST_COUNTS])

    print("\n=== B2. refresh_ip_docs.py (2nd pass, idempotency) ===")
    result = run([sys.executable, str(REFRESH), "--version", VERSION, "--test-counts", TEST_COUNTS])
    if "(no change)" in result.stdout or "(no change)" in result.stderr:
        print("[OK] idempotent (2nd pass reported 'no change')")
    else:
        print("[WARN] 2nd pass did not report 'no change' (check WHITE_PAPER / OSS_COMPLIANCE)")


def step_c_commit_if_changes():
    print("\n=== C. git status after refresh ===")
    result = run(["git", "status", "--short"])
    out = result.stdout.strip()
    if not out:
        print("[SKIP] no changes to commit")
        return
    print(f"[INFO] {len(out.splitlines())} file(s) modified")
    run(["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass",
         "-File", str(GCOMMIT),
         f"docs(ip): refresh for {VERSION}", "-Push"])


def step_d_precheck():
    print("\n=== D. pre_public_check.ps1 ===")
    if not PRECHECK.is_file():
        print(f"[ERR] {PRECHECK} not found")
        sys.exit(1)
    r = run(["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass",
             "-File", str(PRECHECK)], check=False)
    if r.returncode != 0:
        print(f"[WARN] pre_public_check exit={r.returncode}; review output above")


def main() -> int:
    step_a_git_status()
    step_b_refresh_ip_docs()
    step_c_commit_if_changes()
    step_d_precheck()
    print("\n[DONE]")
    return 0


if __name__ == "__main__":
    sys.exit(main())