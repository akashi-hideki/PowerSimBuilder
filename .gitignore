# --- Scenario data (tests/data/scenarios) ---
# Track scenario JSON/XML/Python assets; ignore only transient outputs.
tests/data/scenarios/**/*.pyc
tests/data/scenarios/**/__pycache__/
tests/data/scenarios/**/*.png 

# --- Scenario data: explicitly track system.json ---
!tests/data/scenarios/**/system.json

# Task 3-C-13 GUI/executor debugging artifacts
generated/_diag.py
generated/demo_main_dbg.py
generated/demo_dbg_*.txt
generated/out.txt
generated/err.txt
executor_trace.log
*.bak*

# --- FMU E2E test artifact (regenerate via Import dialog) ---
user_physics_models/Dahlquist/

# Test/debug artifacts
test-output*.txt

# Release notes (generated per-release)
RELEASE_NOTES_v*.md
!RELEASE_NOTES_v1.10.0.md
!RELEASE_NOTES_v1.10.1.md
!RELEASE_NOTES_v1.9.0.md
!RELEASE_NOTES_v1.9.0_zh.md
!RELEASE_NOTES_v1.8.0.md

# StaTable generated outputs (regenerated on import)
generated/*_powersim.py

# FMU downloads from Catalog tab (user data, not source)
user_physics_models/
user_components/

# Generated by tools/build_cross_check_catalog.py (regenerate on demand)
Resources/generated_catalog.json

# IP consultation document - contains company names, keep local only
docs/ip/LAWYER_CONSULTATION.md

docs/ip/LAWYER_CANDIDATES.md

# --- workspace (user projects, not tracked) ---
workspace/projects/*
!workspace/projects/.gitkeep
workspace/components/*
!workspace/components/.gitkeep

# PythonEditorForm temporary execution files
generated/temp_*.py

# Generated by Create Simulation (not a bundled stub)
generated/RecordedSignal.py

# .psbproj backup files
*.psbproj.bak

# pytest basetemp (root-level)
.pytest_tmp/

# Group files (user-generated, not source)
*.psbgroup

# QA: full-resolution CSV (regenerable)
docs/qa/**/simulation_signals_full.csv

# User-recorded signal logs (may contain sensitive plant data)
user_logs/
