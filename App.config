<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  
  <!-- コンポーネント定義設定追加 (2025-08-15) -->
  <appSettings>
    <!-- 定義ファイルディレクトリ (相対パス) -->
    <add key="DefinitionDirectory" value="defines" />
    
    <!-- 定義ファイル名 -->
    <add key="DefinitionFileName" value="ComponentDefinitions.xml" />
    
    <!-- Excel互換モード設定 -->
    <add key="ExcelCompatibilityMode" value="true" />
  </appSettings>
  
  <!-- XMLシリアライザ設定追加 -->
  <system.xml.serialization>
    <xmlSerializer useLegacySerializerGeneration="false" />
  </system.xml.serialization>
</configuration>