@var oven_target_temp   uint16_t degC    Hardware "Target oven temperature" role=target
@var oven_current_temp  uint16_t degC    Hardware "Current oven temperature" role=output
@var heater_top_duty    uint8_t  %       Hardware "Top heater PWM duty"     role=pid_out
@var error_code         uint8_t  -       System   "Error code"              role=error

