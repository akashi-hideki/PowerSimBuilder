# Auto-detect text files, normalize to LF in repo
* text=auto

# Python: LF only
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# C# on Windows: force CRLF in working tree, LF in repo (prevents churn)
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.config text eol=crlf

# Binary
*.png binary
*.ico binary
*.jpg binary
*.zip binary