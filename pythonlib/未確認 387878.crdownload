import math
import numpy as np
from typing import Dict, List, Any
from dataclasses import dataclass
from component_base import Component, ControlMethod, ModulationMethod

@dataclass
class InverterParameters:
    """インバータパラメータのデータクラス"""
    inverter_type: str = 'voltage_source'  # インバータ種類
    topology: str = 'three_phase_bridge'   # トポロジー
    switch_type: str = 'IGBT'              # スイッチ素子種類
    max_dc_voltage: float = 800.0          # 最大DC電圧 [V]
    max_output_current: float = 20.0       # 最大出力電流 [A]
    switch_ron: float = 0.01               # スイッチON抵抗 [Ω]
    switch_vf: float = 1.5                 # スイッチ順方向電圧 [V]
    switch_turn_on_time: float = 0.1       # ターンオン時間 [μs]
    switch_turn_off_time: float = 0.2      # ターンオフ時間 [μs]
    diode_vf: float = 1.2                  # ダイオード順方向電圧 [V]
    control_method: ControlMethod = ControlMethod.V_F_CONTROL  # 制御方式
    carrier_type: str = 'sawtooth'         # キャリア波形 (sawtooth/triangle)
    modulation_method: ModulationMethod = ModulationMethod.SPWM  # 変調方式

class Inverter(Component):
    """
    インバータコンポーネント
    SPWMとSVPWMの変調方式を実装
    """
    
    def __init__(self, comp_id: str, params: InverterParameters = None):
        super().__init__(comp_id, "Inverter")
        self.params = params if params else InverterParameters()
        
        # 入力ポートの定義
        self.inputs = {
            'dc_voltage': 0.0,                  # DC入力電圧 [V]
            'frequency_command': 0.0,           # 周波数指令 [Hz]
            'voltage_command': 0.0,             # 電圧指令 [V] (V/f制御用)
            'dq_commands': [0.0, 0.0],          # dq軸指令 [V] (ベクトル制御用)
            'modulation_index': 0.9,            # 変調度 [0-1]
            'dead_time': 2.0,                   # デッドタイム [μs]
            'switching_frequency': 5000.0,      # スイッチング周波数 [Hz]
            'temperature': 25.0,                # 素子温度 [°C]
        }
        
        # 出力ポートの定義
        self.outputs = {
            'ac_voltage': [0.0, 0.0, 0.0],      # AC出力電圧（3相）[V]
            'ac_current': [0.0, 0.0, 0.0],      # AC出力電流（3相）[A]
            'dc_current': 0.0,                  # DC入力電流 [A]
            'switching_losses': 0.0,            # スイッチング損失 [W]
            'conduction_losses': 0.0,           # 導通損失 [W]
            'efficiency': 0.0,                  # 効率 [%]
            'modulation_waveform': [],          # 変調波形（デバッグ用）
            'harmonic_spectrum': {},            # 高調波スペクトル（デバッグ用）
        }
        
        # パラメータの設定
        self.parameters = {
            'inverter_type': self.params.inverter_type,
            'topology': self.params.topology,
            'switch_type': self.params.switch_type,
            'max_dc_voltage': self.params.max_dc_voltage,
            'max_output_current': self.params.max_output_current,
            'switch_ron': self.params.switch_ron,
            'switch_vf': self.params.switch_vf,
            'switch_turn_on_time': self.params.switch_turn_on_time,
            'switch_turn_off_time': self.params.switch_turn_off_time,
            'diode_vf': self.params.diode_vf,
            'control_method': self.params.control_method.value,
            'carrier_type': self.params.carrier_type,
            'modulation_method': self.params.modulation_method.value,
        }
        
        # 内部状態変数
        self._carrier_angle = 0.0  # キャリア波形の位相
        self._modulation_angle = 0.0  # 変調波形の位相
        self._last_update_time = 0.0
        self._switching_losses = 0.0
        self._conduction_losses = 0.0
        
    def update(self, t: float, dt: float, sim_data: Any = None) -> None:
        """インバータの状態を更新"""
        # 時間ステップの確認
        if dt <= 0:
            return
            
        # 入力値の取得
        dc_voltage = self.inputs['dc_voltage']
        frequency_command = self.inputs['frequency_command']
        voltage_command = self.inputs['voltage_command']
        dq_commands = self.inputs['dq_commands']
        modulation_index = self.inputs['modulation_index']
        dead_time = self.inputs['dead_time']
        switching_frequency = self.inputs['switching_frequency']
        temperature = self.inputs['temperature']
        
        # 変調波の位相更新
        self._modulation_angle += 2 * math.pi * frequency_command * dt
        self._modulation_angle %= 2 * math.pi
        
        # キャリア波の位相更新
        self._carrier_angle += 2 * math.pi * switching_frequency * dt
        self._carrier_angle %= 2 * math.pi
        
        # 変調方式に応じて出力電圧を生成
        if self.params.modulation_method == ModulationMethod.SPWM:
            ac_voltage = self._generate_spwm(dc_voltage, modulation_index, self._modulation_angle, self._carrier_angle)
        else:  # SVPWM
            ac_voltage = self._generate_svpwm(dc_voltage, dq_commands, self._modulation_angle)
        
        # デッドタイム効果の適用
        ac_voltage = self._apply_dead_time(ac_voltage, dead_time, dt)
        
        # 損失計算
        switching_loss, conduction_loss = self._calculate_losses(
            dc_voltage, ac_voltage, switching_frequency, temperature)
        
        # DC電流の計算（簡易モデル）
        dc_current = self._calculate_dc_current(dc_voltage, ac_voltage)
        
        # 効率計算
        input_power = dc_voltage * dc_current
        output_power = sum(v * i for v, i in zip(ac_voltage, [0, 0, 0]))  # 簡易的な計算
        efficiency = output_power / input_power * 100 if input_power > 0 else 0
        
        # 出力の更新
        self.outputs.update({
            'ac_voltage': ac_voltage,
            'ac_current': [0.0, 0.0, 0.0],  # 実際の電流は負荷に依存
            'dc_current': dc_current,
            'switching_losses': switching_loss,
            'conduction_losses': conduction_loss,
            'efficiency': efficiency,
            'modulation_waveform': self._get_modulation_waveform(),
            'harmonic_spectrum': self._calculate_harmonics(ac_voltage),
        })
        
        self._last_update_time = t
    
    def _generate_spwm(self, dc_voltage: float, modulation_index: float, 
                      modulation_angle: float, carrier_angle: float) -> List[float]:
        """正弦波PWMの生成"""
        # キャリア波形の生成
        if self.params.carrier_type == 'sawtooth':
            carrier = (carrier_angle / math.pi) % 2 - 1  # のこぎり波
        else:
            carrier = math.sin(carrier_angle)  # 三角波
        
        # 変調波の生成（3相正弦波）
        modulation_u = modulation_index * math.sin(modulation_angle)
        modulation_v = modulation_index * math.sin(modulation_angle - 2*math.pi/3)
        modulation_w = modulation_index * math.sin(modulation_angle - 4*math.pi/3)
        
        # 変調波とキャリア波の比較
        duty_u = 0.5 + 0.5 * modulation_u
        duty_v = 0.5 + 0.5 * modulation_v
        duty_w = 0.5 + 0.5 * modulation_w
        
        # デューティ比から出力電圧を計算
        voltage_u = dc_voltage * (duty_u - 0.5)
        voltage_v = dc_voltage * (duty_v - 0.5)
        voltage_w = dc_voltage * (duty_w - 0.5)
        
        return [voltage_u, voltage_v, voltage_w]
    
    def _generate_svpwm(self, dc_voltage: float, dq_commands: List[float], 
                       modulation_angle: float) -> List[float]:
        """スペースベクトルPWMの生成"""
        # dq指令をαβ座標に変換
        v_d, v_q = dq_commands
        v_alpha = v_d * math.cos(modulation_angle) - v_q * math.sin(modulation_angle)
        v_beta = v_d * math.sin(modulation_angle) + v_q * math.cos(modulation_angle)
        
        # 基本ベクトルの定義
        vectors = [
            [0, 0, 0],  # V0
            [2/3, -1/3, -1/3],  # V1
            [1/3, 1/3, -2/3],   # V2
            [-1/3, 2/3, -1/3],  # V3
            [-2/3, 1/3, 1/3],   # V4
            [-1/3, -1/3, 2/3],  # V5
            [1/3, -2/3, 1/3],   # V6
            [0, 0, 0],  # V7
        ]
        
        # 簡易的なSVPWM実装（実際はもっと複雑）
        # ここでは簡略化のため、αβ電圧を直接3相に変換
        a = v_alpha
        b = -0.5 * v_alpha + math.sqrt(3)/2 * v_beta
        c = -0.5 * v_alpha - math.sqrt(3)/2 * v_beta
        
        # 電圧をDC電圧でスケーリング
        scale = dc_voltage / math.sqrt(v_alpha**2 + v_beta**2) if (v_alpha**2 + v_beta**2) > 0 else 0
        scale = min(scale, 1.0)  # 過変調防止
        
        return [a * scale, b * scale, c * scale]
    
    def _apply_dead_time(self, voltages: List[float], dead_time: float, dt: float) -> List[float]:
        """デッドタイム効果の適用"""
        # デッドタイムによる電圧低下を簡易モデル化
        dead_time_effect = dead_time * 1e-6 * 1000  # μsをmsに変換して簡易係数乗算
        return [v * (1 - dead_time_effect) for v in voltages]
    
    def _calculate_losses(self, dc_voltage: float, ac_voltage: List[float], 
                         switching_frequency: float, temperature: float) -> tuple:
        """損失計算"""
        # 簡易的な損失モデル
        # スイッチング損失
        switching_loss = (self.params.switch_turn_on_time + self.params.switch_turn_off_time) * \
                        1e-6 * switching_frequency * dc_voltage * 10  # 簡易係数
        
        # 導通損失
        rms_current = math.sqrt(sum(v**2 for v in ac_voltage) / 3) / 10  # 簡易的な電流計算
        conduction_loss = 3 * (self.params.switch_ron * rms_current**2 + 
                              self.params.switch_vf * rms_current)
        
        # 温度補正
        temp_factor = 1 + 0.005 * (temperature - 25)
        switching_loss *= temp_factor
        conduction_loss *= temp_factor
        
        return switching_loss, conduction_loss
    
    def _calculate_dc_current(self, dc_voltage: float, ac_voltage: List[float]) -> float:
        """DC電流の計算（簡易モデル）"""
        # 出力電力から逆算
        output_power = sum(v**2 for v in ac_voltage) / 10  # 簡易的な電力計算
        return output_power / dc_voltage if dc_voltage > 0 else 0
    
    def _get_modulation_waveform(self) -> List[float]:
        """変調波形の取得（デバッグ用）"""
        # 簡易的な波形データ
        return [math.sin(self._modulation_angle + i * 2*math.pi/10) for i in range(10)]
    
    def _calculate_harmonics(self, voltages: List[float]) -> Dict[int, float]:
        """高調波分析（簡易版）"""
        # 基本波成分
        fundamental = math.sqrt(sum(v**2 for v in voltages) / 3)
        
        # 簡易的な高調波モデル
        harmonics = {
            1: fundamental,  # 基本波
            5: fundamental * 0.2,  # 5次高調波
            7: fundamental * 0.1,  # 7次高調波
            11: fundamental * 0.05,  # 11次高調波
            13: fundamental * 0.03,  # 13次高調波
        }
        
        return harmonics
    
    def reset(self):
        """状態をリセット"""
        self._carrier_angle = 0.0
        self._modulation_angle = 0.0
        self._switching_losses = 0.0
        self._conduction_losses = 0.0
        
        # 出力を初期化
        for key in self.outputs:
            if isinstance(self.outputs[key], list):
                self.outputs[key] = [0.0] * len(self.outputs[key])
            else:
                self.outputs[key] = 0.0